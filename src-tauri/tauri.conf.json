{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LimitView",
  "version": "0.1.15",
  "identifier": "com.local.ai-limitusage-watcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LimitView",
        "width": 400,
        "height": 380,
        "minWidth": 360,
        "minHeight": 340,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["binaries/openusage.exe", "binaries/OPENUSAGE-LICENSE.txt"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5NzZGNzVBQjJGQjI4NjgKUldSb0tQdXlXdmQyaVh1QmpUcE5HdWJKMEJKMXlxVzJMTU9iUUJ5b0pISmRxekVMWkRsN0RmcmsK",
      "endpoints": [
        "https://github.com/Termnix-IT/ai-limit-view/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
